# Development-only examples. Never commit real credentials.
DATABASE_URL="postgresql://seebot:local_only_change_me@localhost:5432/seebot_salesos?schema=public"
JWT_SECRET="REPLACE_WITH_64_CHAR_RANDOM_SECRET_BEFORE_STARTING"
CORS_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
API_PORT=4000
NODE_ENV=development
ADMIN_EMAIL="admin@seebot.example"
ADMIN_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"
ADMIN_NAME="Seebot Admin"
SEED_DEMO_DATA=false

# Signatures and external client access remain OFF pending validation
GOOGLE_SIGNING_CLIENT_ID=
NEXT_PUBLIC_SIGNING_GOOGLE_CLIENT_ID=
SIGNING_AUDIT_KEY=
SIGNING_PUBLIC_BASE_URL=
SIGNING_ENABLED=false
SIGNING_EVIDENCE_DIR=
SIGNING_EVIDENCE_PRIVATE_KEY_FILE=
SIGNING_EVIDENCE_PUBLIC_KEY_FILE=

GOOGLE_SELF_SIGNUP_ENABLED=false
GOOGLE_LOGIN_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:4000/api/integrations/gmail/callback
APP_ENCRYPTION_KEY=
GMAIL_SENDING_ENABLED=false
SURVEYS_ENABLED=false
TENANT_SCOPED_CRM_PREVIEW=false


# Required to enable live signing in production: separately administered,
# versioned S3 bucket with Object Lock COMPLIANCE and an approved KMS key.
SIGNING_EVIDENCE_OBJECT_LOCK_BUCKET=
SIGNING_EVIDENCE_KMS_KEY_ARN=
SIGNING_EVIDENCE_RETENTION_DAYS=
SIGNING_EVIDENCE_PUBLIC_KEY_FILE=
AWS_REGION=

# New-company sign-in and CRM remain disabled until audited and approved.
GOOGLE_SELF_SIGNUP_ENABLED=false
TENANT_SCOPED_CRM_PRODUCTION_ENABLED=false

# Self-service account authentication. Private Codespaces only; NEVER enable in production.
DEV_EMAIL_SIGNUP_ENABLED=false

# Production-capable email registration verification and password recovery:
# supply a transactional SMTP provider before enabling public email registration.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_SIGNUP_ENABLED=false

# Preview mailbox: Codespaces only, receives all local password-reset emails.
DEV_MAIL_CAPTURE_ENABLED=false
