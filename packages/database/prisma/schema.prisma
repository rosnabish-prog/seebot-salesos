  invoice Invoice @relation(fields:[invoiceId],references:[id],onDelete:Restrict)
  jurisdiction String
  treatment String
  rationale String @db.Text
  reviewedSubtotal Decimal @db.Decimal(18,2)
  reviewedTax Decimal @db.Decimal(18,2)
  reviewedTotal Decimal @db.Decimal(18,2)
  reviewedById String
  reviewedAt DateTime @default(now())
}
