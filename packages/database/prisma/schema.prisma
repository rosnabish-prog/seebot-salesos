// v1.6.6 — immutable accounting journals and manually reconciled bank statement rows.
// These are accounting-source records, not claims that banking/tax integration is certified.
model AccountingJournal {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  externalKey String
  sourceType String
  sourceId String
  currency String
  memo String
  postedById String
  postedAt DateTime @default(now())
  reversedJournalId String?
  postings AccountingPosting[]
  @@unique([organizationId,externalKey])
  @@index([organizationId,postedAt])
  @@index([sourceType,sourceId])
}
model AccountingPosting {
  id String @id @default(cuid())
  journalId String
  journal AccountingJournal @relation(fields:[journalId],references:[id],onDelete:Restrict)
  accountCode String
  side String // DEBIT | CREDIT
  amountMinor BigInt
  @@index([journalId])
}
model BankStatementRow {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
  bankAccountReference String
  statementReference String
  currency String
  amountMinor BigInt
  valueDate DateTime
  paymentRecordId String? @unique
  paymentRecord PaymentRecord? @relation(fields:[paymentRecordId],references:[id],onDelete:Restrict)
  matchedById String?
  matchedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([organizationId,bankAccountReference,statementReference])
  @@index([organizationId,valueDate])
}

